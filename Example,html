function RatingPage({ currentUser, setCurrentUser }) {
  const [selected, setSelected] = useState(null);
  const [feedback, setFeedback] = useState('');
  const [log, setLog] = useState([]);
  const tier = currentUser ? getTier(currentUser.rating) : null;

  const simulateMatch = (outcome) => {
    if (!currentUser) return;
    const change = eloChange(outcome);
    const newRating = Math.max(400, currentUser.rating + change);
    const updated = {
      ...currentUser, rating: newRating,
      wins: outcome === 'win' ? currentUser.wins + 1 : currentUser.wins,
      losses: outcome === 'loss' ? currentUser.losses + 1 : currentUser.losses,
      played: currentUser.played + 1
    };
    setCurrentUser(updated);
    const opp = SAMPLE_PLAYERS[Math.floor(Math.random() * SAMPLE_PLAYERS.length)];
    setLog(l => [{ outcome, change, opp: opp.name, newRating }, ...l.slice(0, 7)]);
    setSelected(null); setFeedback('');
  };

  return (
    <div className="page-sm fade-in">
      <div className="section-header">
