                  <span style={{ fontFamily: 'Bebas Neue, sans-serif', fontSize: 16, color: 'var(--ink-30)', letterSpacing: '0.5px', minWidth: 36 }}>→ {entry.newRating}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

/* ─── MATCH PAGE ─────────────────────────────────────────────────── */
function MatchPage({ currentUser }) {
  const [filters, setFilters] = useState({ sport: 'all', skill: 'all', city: 'all', availability: 'all' });
  const [search, setSearch] = useState('');
  const [sent, setSent] = useState([]);
  const [view, setView] = useState('grid');

  const allPlayers = SAMPLE_PLAYERS.filter(p => !currentUser || p.id !== currentUser?.id);

  const filtered = allPlayers.filter(p => {
    if (filters.sport !== 'all' && p.sport !== filters.sport) return false;
    if (filters.skill !== 'all' && p.skill !== filters.skill) return false;
    if (filters.city !== 'all' && p.city !== filters.city) return false;
    if (filters.availability !== 'all' && !p.availability.includes(filters.availability)) return false;
    if (search && !p.name.toLowerCase().includes(search.toLowerCase())) return false;
    return true;
  }).sort((a, b) => {
    if (!currentUser) return 0;
    return Math.abs(a.rating - currentUser.rating) - Math.abs(b.rating - currentUser.rating);
  });

  return (
    <div className="page fade-in">
      {/* Hero */}
      <div className="hero mb-32">
        <div className="hero-eyebrow">Player Discovery</div>
        <div className="hero-title">FIND YOUR<br/><span>NEXT OPPONENT</span></div>
        <div className="hero-sub">
          {currentUser
            ? `Showing ${filtered.length} players sorted by rating proximity to yours (${currentUser.rating} ELO)`
            : 'Browse all registered players. Create a profile for personalized smart matching.'}
        </div>
      </div>

      {/* Filter bar */}
      <div className="filter-bar mb-24">
        <input className="form-input" value={search} onChange={e => setSearch(e.target.value)}
          placeholder="🔍  Search by name..." style={{ minWidth: 180, maxWidth: 220 }} />
        {[
          { key: 'sport', opts: [{ v: 'all', l: 'All Sports' }, ...SPORTS.map(s => ({ v: s.id, l: `${s.icon} ${s.label}` }))] },
          { key: 'skill', opts: [{ v: 'all', l: 'All Levels' }, ...SKILL_LEVELS.map(s => ({ v: s.id, l: s.label }))] },
          { key: 'city', opts: [{ v: 'all', l: 'All Cities' }, ...CITIES.map(c => ({ v: c, l: c }))] },
          { key: 'availability', opts: [{ v: 'all', l: 'Any Time' }, { v: 'mornings', l: '☀️ Mornings' }, { v: 'evenings', l: '🌆 Evenings' }, { v: 'weekends', l: '📅 Weekends' }] },
        ].map(f => (
          <select key={f.key} className="form-input" style={{ maxWidth: 150 }} value={filters[f.key]} onChange={e => setFilters(p => ({ ...p, [f.key]: e.target.value }))}>
            {f.opts.map(o => <option key={o.v} value={o.v}>{o.l}</option>)}
          </select>
        ))}
        <span className="filter-count">{filtered.length} players</span>
      </div>

      {/* Grid */}
      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(296px, 1fr))', gap: 20 }}>
        {filtered.map(player => {
          const tier = getTier(player.rating);
          const sport = SPORTS.find(s => s.id === player.sport);
          const wr = winRate(player.wins, player.played);
          const ratingDiff = currentUser ? player.rating - currentUser.rating : null;
          const isBest = ratingDiff !== null && Math.abs(ratingDiff) <= 200;
          const hasSent = sent.includes(player.id);

          return (
            <div key={player.id} className={`player-card ${isBest && currentUser ? 'best-match' : ''}`}>
              {/* Color accent top */}
              <div style={{ height: 4, background: `linear-gradient(90deg, ${tier.color}, ${tier.color}44)` }} />

              <div className="player-card-body">
                {isBest && currentUser && (
                  <div style={{ position: 'absolute', top: 16, right: 16 }}>
                    <span className="badge badge-green" style={{ fontSize: 10 }}>⚡ Great Match</span>
                  </div>
                )}

                {/* Header */}
                <div className="flex items-center gap-12 mb-16">
                  <Avatar initials={player.avatar} size={50} rating={player.rating} />
                  <div style={{ flex: 1, minWidth: 0 }}>
                    <div style={{ fontFamily: 'Oswald, sans-serif', fontSize: 19, fontWeight: 600, color: 'var(--ink)', letterSpacing: '0.5px', lineHeight: 1.1 }}>{player.name}</div>
                    <div className="text-xs text-muted mt-4">📍 {player.city} · {sport?.icon} {sport?.label}</div>
                  </div>
                </div>

                {/* Badges */}
                <div className="flex gap-6 wrap mb-12">
                  <span className="badge" style={{ background: tier.pale, color: tier.color, borderColor: `${tier.color}33` }}>{tier.label}</span>
                  <span className="badge badge-ink">{player.rating} ELO</span>
                  {ratingDiff !== null && (
                    <span className="badge" style={Math.abs(ratingDiff) <= 100 ? { background: 'var(--turf-pale)', color: 'var(--turf)' } : ratingDiff > 0 ? { background: '#fee2e2', color: '#dc2626' } : { background: 'var(--track-pale)', color: 'var(--track)' }}>
                      {ratingDiff > 0 ? '▲' : ratingDiff < 0 ? '▼' : '='} {Math.abs(ratingDiff)}
                    </span>
                  )}
                </div>

                {/* Bio */}
                {player.bio && <p className="text-sm mb-12" style={{ color: 'var(--ink-50)', lineHeight: 1.5 }}>{player.bio}</p>}

                {/* Mini stats */}
                <div className="flex gap-8 mb-12">
                  {[{ l: 'W', v: player.wins, c: 'var(--turf)' }, { l: 'L', v: player.losses, c: '#ef4444' }, { l: 'WR', v: `${wr}%`, c: 'var(--gold)' }].map(s => (
                    <div key={s.l} style={{ flex: 1, background: 'var(--ink-5)', borderRadius: 6, padding: '8px 4px', textAlign: 'center' }}>
                      <div style={{ fontFamily: 'Bebas Neue, sans-serif', fontSize: 20, color: s.c, letterSpacing: '0.5px' }}>{s.v}</div>
                      <div style={{ fontFamily: 'Oswald, sans-serif', fontSize: 9, letterSpacing: '1px', color: 'var(--ink-30)', textTransform: 'uppercase', marginTop: 1 }}>{s.l}</div>
                    </div>
                  ))}
                </div>

                {/* Availability */}
                <div className="flex gap-6 wrap mb-16">
                  {player.availability.map(a => (
                    <span key={a} className="badge badge-orange" style={{ fontSize: 10 }}>{a}</span>
                  ))}
                </div>

                {/* CTA */}
                <button onClick={() => !hasSent && setSent(s => [...s, player.id])}
                  className={`btn btn-full ${hasSent ? 'btn-outline' : 'btn-orange'}`}
                  style={{ fontFamily: 'Oswald, sans-serif', letterSpacing: '1.5px', textTransform: 'uppercase', fontSize: 13 }}>
                  {hasSent ? '✓ Request Sent' : 'Send Match Request'}
                </button>
              </div>
            </div>
          );
        })}
        {filtered.length === 0 && (
          <div className="empty">
            <div className="empty-icon">🔍</div>
            <div className="empty-title">No Players Found</div>
            <div className="empty-sub">Try adjusting your filters or search term</div>
          </div>
        )}
      </div>
    </div>
  );
}

/* ─── LANDING (no profile) ────────────────────────────────────────── */
function LandingBanner({ setPage }) {
  return (
    <div style={{ background: 'linear-gradient(135deg, #2D6A4F, #52B788)', borderRadius: 'var(--radius-lg)', padding: '32px 36px', margin: '0 0 32px', display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: 16 }}>
      <div>
        <p style={{ fontFamily: 'Oswald, sans-serif', fontSize: 11, letterSpacing: '3px', color: 'rgba(255,255,255,0.65)', marginBottom: 6, textTransform: 'uppercase' }}>Welcome to SportsConnect</p>
        <p style={{ fontFamily: 'Bebas Neue, sans-serif', fontSize: 32, color: 'white', letterSpacing: '1px', lineHeight: 1 }}>FIND YOUR GAME. GROW YOUR GAME.</p>
        <p style={{ color: 'rgba(255,255,255,0.75)', fontSize: 14, marginTop: 6 }}>Create a free profile to get matched with players at your skill level.</p>
      </div>
      <button className="btn btn-lg" onClick={() => setPage('profile')} style={{ background: 'white', color: 'var(--turf)', fontFamily: 'Oswald, sans-serif', letterSpacing: '1.5px', textTransform: 'uppercase', flexShrink: 0, boxShadow: '0 4px 16px rgba(0,0,0,0.15)' }}>
        Create Profile →
      </button>
    </div>
  );
}

/* ─── APP ─────────────────────────────────────────────────────────── */
function App() {
  const [page, setPage] = useState('profile');
  const [currentUser, setCurrentUser] = useState(null);

  return (
    <div style={{ minHeight: '100vh', background: 'var(--chalk)' }}>
      <NavBar page={page} setPage={setPage} currentUser={currentUser} />
      {page === 'match' && !currentUser && (
        <div className="page" style={{ paddingBottom: 0 }}>
          <LandingBanner setPage={setPage} />
        </div>
      )}
      {page === 'profile' && <ProfilePage currentUser={currentUser} setCurrentUser={setCurrentUser} />}
      {page === 'rating' && <RatingPage currentUser={currentUser} setCurrentUser={setCurrentUser} />}
      {page === 'match' && <MatchPage currentUser={currentUser} />}
    </div>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<App />);
</script>
</body>
</html>
