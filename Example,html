/* ─── HELPERS ─────────────────────────────────────────────────────── */
function getTier(rating) {
  if (rating >= 1600) return { label: 'Pro', color: '#7C3AED', pale: '#EDE9FE', badgeClass: 'badge-track' };
  if (rating >= 1400) return { label: 'Advanced', color: '#F4700C', pale: '#FEE8D6', badgeClass: 'badge-orange' };
  if (rating >= 1200) return { label: 'Intermediate', color: '#D4A017', pale: '#FEF3C7', badgeClass: 'badge-gold' };
  if (rating >= 1000) return { label: 'Amateur', color: '#2D6A4F', pale: '#D8F3DC', badgeClass: 'badge-green' };
  return { label: 'Beginner', color: '#1B4FD8', pale: '#DBEAFE', badgeClass: 'badge-track' };
}
function getRatingBar(rating) {
  return Math.round(((Math.min(rating, 1800) - 600) / 1200) * 100);
}
function winRate(wins, played) {
  return played ? Math.round((wins / played) * 100) : 0;
}
function eloChange(outcome) {
  const scores = { win: 1, draw: 0.5, loss: 0 };
  return Math.round(32 * (scores[outcome] - 0.5));
}
function Avatar({ initials, size = 44, rating, style: extraStyle }) {
  const tier = getTier(rating || 0);
  return (
    <div className="avatar" style={{
      width: size, height: size,
      fontSize: size * 0.32,
      background: `linear-gradient(135deg, ${tier.color}cc, ${tier.color})`,
      border: `2px solid ${tier.color}`,
      boxShadow: `0 2px 8px ${tier.color}44`,
      ...extraStyle
    }}>{initials}</div>
  );
}

